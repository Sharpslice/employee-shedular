// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
    USER 
    ADMIN
}
enum Position {
    PHARMACIST
    TECHNICIAN
}

model Employee {
  id              Int         @id @default(autoincrement())
  googleId        String      @unique
  email           String      @unique
  name            String
  phone_number    String?
  role            Role        @default(USER)
  position        Position?   
  color           String?
  isWorking       Boolean
  picture         String?

  shifts          Employee_Shifts[]
  availability    Employee_Availability[]
  override        Employee_Time_Override[]

  @@map("employee")
}

model Employee_Shifts{
    id                Int       @id @default(autoincrement())
    employee_id       Int
    date              DateTime  @db.Date
    start_time        DateTime?   @db.Timestamptz
    end_time          DateTime?   @db.Timestamptz

    employee          Employee  @relation(fields: [employee_id], references:id)
    calendar          Calendar  @relation(fields: [date],references:date)

    @@map("employee_shifts")
}

model Employee_Availability{
    id                      Int       @id @default(autoincrement())
    employee_id             Int
    day_of_week             Int
    is_available            Boolean
    time_block_id           Int?



    employee                                   Employee  @relation(fields:[employee_id],references:id)
    time_block        Employee_Availability_Time_Block? @relation(fields: [time_block_id], references: [id])
    @@map("employee_availability")
}

model Employee_Availability_Time_Block{
    id                      Int       @id @default(autoincrement())
    start_time              DateTime    @db.Timestamptz
    end_time                DateTime    @db.Timestamptz

    employee_availabilities Employee_Availability[]
    @@map("employee_availability_time_block")
}

model Employee_Time_Override{
    id                      Int         @id @default(autoincrement())
    employee_id             Int
    date                    DateTime    @db.Date
    is_available            Boolean
    note                    String?

    employee                Employee @relation(fields:[employee_id],references:id)
    calendar                Calendar @relation(fields:[date],references:date)

    @@unique([employee_id,date])
    @@map("employee_time_override")
}

model Employee_Override_Time_Block{
    id                      Int         @id @default(autoincrement())
    start_time              DateTime    @db.Timestamptz
    end_time                DateTime    @db.Timestamptz

    @@map("employee_override_time_block")
}

model Calendar{
    date              DateTime        @id @db.Date
    day_of_month      Int
    days_of_week      Int
    week              Int
    month             Int
    year              Int
    is_weekend        Boolean
    is_holiday        Boolean
    holiday_name      String?

    shift_dates       Employee_Shifts[]
    override_dates    Employee_Time_Override[]

    @@map("calendar")
}


